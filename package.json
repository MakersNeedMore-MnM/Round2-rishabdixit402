{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,api -c blue,green \"node scripts/dev-web.js\" \"node scripts/dev-api.js\"",
    "dev:web": "node scripts/dev-web.js",
    "dev:api": "node scripts/dev-api.js",
    "build": "next build",
    "dev:all": "npm run dev",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
