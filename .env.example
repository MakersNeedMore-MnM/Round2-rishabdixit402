# ReGit environment template.
# Copy to .env and fill in real values:  cp .env.example .env
# Never commit the real .env anywhere.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:password@localhost:5432/regit"

# Session signing key. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production (FLASK_DEBUG=false); in debug mode a random
# per-process key is used if this is unset (sessions reset on restart).
SECRET_KEY="change-me"

# --- Optional ---------------------------------------------------------------

# Flask dev server
PORT=5000
FLASK_DEBUG=true

# GitHub Personal Access Token ("repo", "read:user" scopes) - used as the
# default token for importing/scanning/committing when a user has not linked
# their own GitHub account.
GITHUB_TOKEN=""

# GitHub OAuth App (web sign-in flow). Leave empty to disable OAuth sign-in.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Browser-facing base URL used to build the OAuth redirect_uri
# (e.g. https://regit.example.com). Empty = derive from the request host.
PUBLIC_APP_URL=""
# Full redirect_uri override; wins over PUBLIC_APP_URL when set.
GITHUB_REDIRECT_URI=""

# Session lifetime in days.
SESSION_DAYS=30
# Force the Secure flag on session cookies (set this behind HTTPS).
COOKIE_SECURE=false

# Browser origins allowed to call the API with credentials (comma-separated).
# No wildcard - "*" is invalid together with credentials.
# CORS_ORIGINS=https://regit.example.com

# --- AI (optional) ----------------------------------------------------------

# Finding explanations fall back to a local heuristic provider when unset.
OPENAI_API_KEY=""
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
